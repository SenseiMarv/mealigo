{
  "name": "mealiego",
  "main": "expo-router/entry",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "start": "EXPO_UNSTABLE_MCP_SERVER=1 expo start",
    "start:android": "EXPO_UNSTABLE_MCP_SERVER=1 expo start --android",
    "start:ios": "EXPO_UNSTABLE_MCP_SERVER=1 expo start --ios",
    "lint": "concurrently -c 'auto' 'pnpm:lint:*(!fix)'",
    "lint:expo": "expo lint",
    "lint:knip": "knip",
    "lint:fix": "concurrently -c 'auto' 'pnpm:lint:fix:*'",
    "lint:fix:expo": "expo lint --fix",
    "lint:fix:knip": "knip --fix --allow-remove-files --format",
    "test": "jest --coverage=false",
    "test:ci": "jest",
    "expo:install": "pnpm expo install",
    "expo:doctor": "pnpx expo-doctor@latest",
    "expo:upgrade": "pnpx expo install expo@latest --fix"
  },
  "dependencies": {
    "@dev-plugins/react-navigation": "0.4.0",
    "@dev-plugins/react-query": "0.4.0",
    "@expo/ui": "57.0.16",
    "@gorhom/bottom-sheet": "5.2.14",
    "expo": "57.0.20",
    "expo-constants": "57.0.17",
    "expo-device": "57.0.1",
    "expo-font": "57.0.3",
    "expo-glass-effect": "57.0.1",
    "expo-image": "57.0.4",
    "expo-linking": "57.0.9",
    "expo-router": "57.0.19",
    "expo-splash-screen": "57.0.8",
    "expo-status-bar": "57.0.1",
    "expo-symbols": "57.0.2",
    "expo-system-ui": "57.0.3",
    "expo-web-browser": "57.0.2",
    "heroui-native": "1.0.9",
    "react": "19.2.3",
    "react-native": "0.86.3",
    "react-native-gesture-handler": "2.32.0",
    "react-native-reanimated": "4.5.1",
    "react-native-safe-area-context": "5.7.0",
    "react-native-screens": "4.26.2",
    "react-native-svg": "15.15.4",
    "react-native-worklets": "0.10.1",
    "tailwind-merge": "3.6.0",
    "tailwind-variants": "3.3.1",
    "tailwindcss": "4.3.3",
    "uniwind": "1.12.0"
  },
  "devDependencies": {
    "@testing-library/react-native": "13.3.3",
    "@types/jest": "29.5.14",
    "@types/node": "26.5.0",
    "@types/react": "19.2.18",
    "concurrently": "10.0.5",
    "eslint": "9.39.5",
    "eslint-config-expo": "57.0.2",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-better-tailwindcss": "4.7.0",
    "eslint-plugin-prettier": "5.5.6",
    "expo-mcp": "0.2.4",
    "jest": "29.7.0",
    "jest-expo": "57.0.5",
    "knip": "6.34.0",
    "prettier": "3.9.6",
    "typescript": "6.0.3"
  },
  "engines": {
    "node": ">=24.0.0 <25.0.0",
    "pnpm": ">=11.0.0 <12.0.0"
  },
  "packageManager": "pnpm@12.2.1",
  "jest": {
    "preset": "jest-expo",
    "collectCoverage": true,
    "collectCoverageFrom": [
      "**/*.{ts,tsx,js,jsx}",
      "!**/coverage/**",
      "!**/node_modules/**",
      "!**/babel.config.js",
      "!**/expo-env.d.ts",
      "!**/.expo/**"
    ]
  }
}
